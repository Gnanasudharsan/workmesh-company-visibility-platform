{
  "name": "workmesh",
  "private": true,
  "description": "WorkMesh — Know who's building what. Understand how it all connects.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "copilot:try": "pnpm --filter @workmesh/api run copilot:try"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "@swc/core",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": "^2.5.0",
      "path-to-regexp@8": "^8.4.0",
      "deepmerge-ts": "^8.0.0"
    }
  }
}

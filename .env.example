# ---------------------------------------------------------------------------
# WorkMesh local configuration. Copy to `.env` (make setup does this for you).
# Never commit real credentials. All values below are local-development only.
# ---------------------------------------------------------------------------

# Docker Compose project name — isolated from other local stacks.
COMPOSE_PROJECT_NAME=workmesh

# Host ports (chosen to avoid colliding with other local projects).
WORKMESH_WEB_PORT=3002
WORKMESH_API_PORT=8020
WORKMESH_PG_PORT=55462
WORKMESH_REDIS_PORT=56402

# PostgreSQL. Two roles:
#   workmesh_owner — owns schema, runs migrations, used for system/auth operations
#   workmesh_app   — restricted role subject to Row-Level Security; serves tenant requests
POSTGRES_PASSWORD=change-me-local-owner
WORKMESH_APP_DB_PASSWORD=change-me-local-app
DATABASE_URL=postgresql://workmesh_owner:change-me-local-owner@localhost:55462/workmesh?schema=public
APP_DATABASE_URL=postgresql://workmesh_app:change-me-local-app@localhost:55462/workmesh?schema=public

REDIS_URL=redis://localhost:56402

# API
API_PORT=8020
WEB_ORIGIN=http://localhost:3002
SESSION_TTL_HOURS=72
# Cookie `Secure` flag. Must be true behind HTTPS in production.
COOKIE_SECURE=false
# Protects /api/metrics. Generate with: openssl rand -hex 24
METRICS_TOKEN=change-me-local-metrics
# Run the BullMQ worker inside the API process (true) or as a separate process (false).
WORKER_INLINE=true
# Enables one-click demo persona login and the local dev mailbox. Never enable in production.
DEMO_MODE=true
LOG_LEVEL=info

# Ask the Mesh copilot (docs/COPILOT.md). Off by default: every copilot endpoint returns 404.
# The DEMO_MODE-only tool endpoint used by `pnpm copilot:try` needs both flags on.
COPILOT_ENABLED=false
# Per-client requests per minute to copilot endpoints.
COPILOT_RATE_LIMIT_PER_MINUTE=10
# Model provider: ollama (local, default) | anthropic (hosted, optional) | fake (scripted; tests and
# demos without a model — refused in production).
COPILOT_PROVIDER=ollama
# Model name. Defaults: ollama → qwen2.5:7b-instruct, anthropic → claude-opus-5-5.
COPILOT_MODEL=
OLLAMA_URL=http://localhost:11434
# Only for COPILOT_PROVIDER=anthropic. Sends the viewer's authorized tool results to Anthropic.
# Leave empty to use the SDK's other credential sources (e.g. an `ant auth login` profile).
ANTHROPIC_API_KEY=
# Tool calls allowed per question, and the whole-question time budget.
COPILOT_MAX_TOOL_CALLS=6
COPILOT_TIMEOUT_MS=45000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8020
